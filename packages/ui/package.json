    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.17.0",
    "cmdk": "^1.1.1",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.3.0",
