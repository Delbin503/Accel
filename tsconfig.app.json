{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@accel/ui":       ["./packages/ui/src/index.ts"],
      "@accel/ui/*":     ["./packages/ui/src/*"],
      "@/components/ui/*":     ["./packages/ui/src/components/ui/*"],
      "@/components/shared":   ["./packages/ui/src/components/shared"],
      "@/components/shared/*": ["./packages/ui/src/components/shared/*"],
      "@/components/charts":   ["./packages/ui/src/components/charts"],
      "@/components/charts/*": ["./packages/ui/src/components/charts/*"],
      "@/components/custom/*": ["./packages/ui/src/components/custom/*"],
      "@/components/layout":   ["./packages/ui/src/components/layout"],
      "@/components/layout/*": ["./packages/ui/src/components/layout/*"],
      "@/lib/utils":       ["./packages/ui/src/lib/utils"],
      "@/lib/formatters":  ["./packages/ui/src/lib/formatters"],
      "@/lib/tokens":      ["./packages/ui/src/lib/tokens"],
      "@/lib/dialCodes":   ["./packages/ui/src/lib/dialCodes"],
      "@/lib/playback":    ["./packages/ui/src/lib/playback"],
      "@/hooks/use-mobile": ["./packages/ui/src/hooks/use-mobile"],
      "@/*":             ["./src/*"],
      "@/components":    ["./src/components"],
      "@/components/*":  ["./src/components/*"],
      "@/lib":           ["./src/lib"],
      "@/lib/*":         ["./src/lib/*"],
      "@/hooks":         ["./src/hooks"],
      "@/hooks/*":       ["./src/hooks/*"],
      "@/stores":        ["./src/stores"],
      "@/stores/*":      ["./src/stores/*"],
      "@/types":         ["./src/types"],
      "@/types/*":       ["./src/types/*"],
      "@/pages":         ["./src/pages"],
      "@/pages/*":       ["./src/pages/*"]
    }
  },
  "include": ["src", "packages/ui/src", "packages/ui/test"]
}
