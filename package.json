{
  "name": "scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck:prototypes": "tsc -p tsconfig.protocheck.json",
    "lint": "node scripts/check-tokens.mjs && node scripts/check-slots.mjs && node scripts/check-components.mjs && eslint .",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:slots": "node scripts/check-slots.mjs",
    "lint:components": "node scripts/check-components.mjs",
    "lint:prune": "eslint . --prune-suppressions",
    "preview": "vite preview",
    "prototype": "vite --config prototypes/vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "storybook build --quiet && node scripts/check-a11y.mjs",
    "lint:changelog": "node scripts/check-changelog.mjs",
    "chromatic": "chromatic --exit-zero-on-changes --project-token \"$CHROMATIC_PROJECT_TOKEN\"",
    "test:a11y:pages": "vite build --config prototypes/vite.config.ts --logLevel warn && node scripts/check-a11y-pages.mjs"
  },
  "dependencies": {
    "@accel/ui": "1.1.0",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.12.0",
    "chromatic": "^18.14.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^31.0.1",
    "puppeteer-core": "^23.11.1",
    "storybook": "^10.4.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
